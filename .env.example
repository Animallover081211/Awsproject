AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# AWS Service Names/URLs
S3_BUCKET=your-bucket-name
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ImageProcessingQueue
DYNAMODB_TABLE=ImageMetadata
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:ImageAlerts

# EC2 Config
EC2_KEY_NAME=my-key-pair
EC2_SECURITY_GROUP_ID=sg-0123456789abcdef0
EC2_SUBNET_ID=subnet-0123456789abcdef0
EC2_INSTANCE_TYPE=t2.micro

# Image Upload Config
IMAGE_FOLDER=./images
UPLOAD_INTERVAL=30
